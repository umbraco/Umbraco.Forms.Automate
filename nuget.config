<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Umbraco Nightly" value="https://www.myget.org/F/umbraconightly/api/v3/index.json" />
    <add key="Umbraco Prereleases" value="https://www.myget.org/F/umbracoprereleases/api/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="Umbraco Prereleases">
      <!-- Umbraco.Licenses 19.0.0-beta was removed from MyGet and rc1 needs CMS rc1, which is only on the prereleases feed. Remove these two Umbraco.Cms entries once CMS 19 is stable on nuget.org. -->
      <package pattern="Umbraco.Cms.*" />
      <package pattern="Umbraco.Cms" />
      <package pattern="Umbraco" />
      <package pattern="Umbraco.*" />
    </packageSource>
    <packageSource key="Umbraco Nightly">
      <package pattern="Umbraco" />
      <package pattern="Umbraco.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Umbraco" />
      <package pattern="Umbraco.*" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
