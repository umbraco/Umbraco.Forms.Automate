<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Ignore mappings inherited from parent configs, such as a worktree inside another line's checkout. -->
    <clear />
    <packageSource key="nuget.org">
      <package pattern="Umbraco" />
      <package pattern="Umbraco.*" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
